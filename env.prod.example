# Copiar a .env.prod.local o .env.prod (gitignored) antes de build prod.
# Backend REST + Socket.IO prod → https://api-prodtx.taxitexi.com
TEXI_APP_ENV=prod
TEXI_BACKEND_BASE_URL=https://api-prodtx.taxitexi.com
GOOGLE_MAPS_API_KEY=REEMPLAZA_CON_TU_API_KEY_PROD
TURNSTILE_SITE_KEY=REEMPLAZA_CON_TU_SITE_KEY
GOOGLE_OAUTH_SERVER_CLIENT_ID=REEMPLAZA_CON_TU_WEB_CLIENT_ID.apps.googleusercontent.com
