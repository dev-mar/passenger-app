# Copiar a .env.prod.local o .env.prod (gitignored) antes de build prod.
# GCP/Firebase prod: prodtexiappgm (NO usar keys de taxitexiapp-org / My First Project).
# Runbook: .cursor/runbooks/passenger-maps-prodtexiappgm-setup.md
# Backend REST + Socket.IO prod → https://api-prodtx.taxitexi.com
TEXI_APP_ENV=prod
TEXI_BACKEND_BASE_URL=https://api-prodtx.taxitexi.com
TEXI_PASSENGER_MULTICHANNEL_AUTH=true
# Key A — widget GoogleMap (Maps SDK for Android). Restriccion: Android apps + com.taxitexi.texi_passenger_app + SHA-1 upload.
GOOGLE_MAPS_API_KEY=REEMPLAZA_CON_TU_API_KEY_ANDROID_SDK_PROD
# Key B — lupa/rutas HTTP (Places legacy + Geocoding + Directions). Restriccion: solo esas APIs; Application = None.
GOOGLE_MAPS_REST_API_KEY=REEMPLAZA_CON_TU_API_KEY_REST_PROD
TURNSTILE_SITE_KEY=REEMPLAZA_CON_TU_SITE_KEY
GOOGLE_OAUTH_SERVER_CLIENT_ID=REEMPLAZA_CON_TU_WEB_CLIENT_ID.apps.googleusercontent.com
