GOOGLE_MAPS_API_KEY=REEMPLAZA_CON_TU_API_KEY
TEXI_BACKEND_BASE_URL=https://api.dev.taxitexi.com
# Fase 2 step-up (Cloudflare Turnstile site key pública — misma que VITE_TURNSTILE_SITE_KEY admin)
TURNSTILE_SITE_KEY=REEMPLAZA_CON_TU_SITE_KEY
# Web client ID OAuth (Firebase → Authentication → Google → Web SDK)
GOOGLE_OAUTH_SERVER_CLIENT_ID=REEMPLAZA_CON_TU_WEB_CLIENT_ID.apps.googleusercontent.com
# Opcional QA dev: activar UI multicanal sin flavor prod
# TEXI_PASSENGER_MULTICHANNEL_AUTH=true
